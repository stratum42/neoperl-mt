    # :XSAsm side-by-side split with VSX/TOC/barrier extmarks
    my $asm_buf = $xdev->_open_asm_split($ann);
    ok($asm_buf && scalar(@{ $asm_buf->get_extmarks('xs_asm') }) >= 5,
        ':XSAsm split created with VSX/MMA/TOC/barrier/SMT extmark highlights');

    # :XSVecReport inline loop extmark painting
    my $vbuf = $ed->create_buffer(name => 'vec_simd.c', filetype => 'c', text => ("// line\n" x 150));
    my $vpainted = $xdev->power->paint_vec_annotations($vbuf, $vparse);
    is($vpainted, 1, ':XSVecReport painted inline loop vectorization extmark');

    # Sanitizer finding recorded into Db2/SQLite Memory Store
    if ($store) {
        $xdev->_publish_sanitizer_results({ ok => 1, tool => 'valgrind', findings => $vg_f }, record_memory => 1);
        my $hits = $store->search(query => 'VALGRIND invalid-access Demo.xs', limit => 5);
        cmp_ok(scalar(@$hits), '>=', 1, 'sanitizer finding persisted to Memory::Store for recall');
    }
    else {
        pass('Memory::Store optional');
    }

    # Dynamic OptionSet propagation for xs_remote_host / xs_remote_workdir
    $ed->set_option('xs_remote_host', 'example-lab');
    $ed->set_option('xs_remote_workdir', '/tmp/npl-scratch');
    is($xdev->runner->remote_host, 'example-lab', 'Editor OptionSet propagated xs_remote_host to XSDev::Runner');
    $ed->set_option('xs_remote_host', '');
    $ed->set_option('xs_remote_workdir', '');

    # XSDEV Command Center tab provider
    my $cc_data = $ed->get_command_center_data('xsdev');
    ok(ref($cc_data) eq 'HASH' && exists $cc_data->{debugger} && exists $cc_data->{profiler},
        'XSDEV Command Center tab provider returns debugger + profiler + pgo + power state');

    # :XSPowerAudit via ExCmd
    my $abuf = $ed->create_buffer(name => 'buggy.c', filetype => 'c', text => $buggy_power_c);
    $ed->switch_buffer($abuf->id);
    my $acmd = $ed->exec_command(':XSPowerAudit');
    ok($acmd->{ok} && !$acmd->{clean}, ':XSPowerAudit Ex command ran on active C buffer');
    cmp_ok(scalar(@{ $ed->get_diagnostics($abuf, source => 'xs_power_audit') }), '>=', 5,
        ':XSPowerAudit published diagnostics into Editor');

    if ($mcp) {
        for my $t (qw(neoperl_xs_profile neoperl_xs_sanitize neoperl_xs_backtrace neoperl_xs_pgo neoperl_xs_arch_audit)) {
            ok($mcp->has_tool($t), "EditorMCP registered $t");
        }
        is(scalar(@{ $mcp->list_tool_names }), 23,
            'ALL 23 EditorMCP tools registered (14 core/AI + 4 PerlDev + 5 XSDev)');
        my $ma = $mcp->call_tool_local('neoperl_xs_arch_audit', { text => $buggy_power_c, path => 'buggy.c' });
        cmp_ok($ma->{summary}{total}, '>=', 5, 'MCP neoperl_xs_arch_audit caught POWER traps');
    }
    else {
        pass('EditorMCP optional skip') for 1 .. 7;
    }

    $pdev->shutdown;
    $xdev->shutdown;
}

$xsdev->shutdown;
done_testing();
