# Create a synthetic xsubpp-generated .c file with #line directives pointing to Demo.xs
my $demo_xs = File::Spec->catfile($tmp, 'Demo.xs');
my $demo_c  = File::Spec->catfile($tmp, 'Demo.c');
open my $xfh, '>', $demo_xs or die $!;
print {$xfh} "/* Demo.xs */\n" x 60;
close $xfh;
open my $cfh, '>', $demo_c or die $!;
print {$cfh} <<'CFILE';
/* generated by xsubpp */
#include <stddef.h>
#line 40 "Demo.xs"
int xs_hot_fn(int x) {
    int y = x * 2;
    return y + 1;
}
#line 12 "Demo.c"
int generated_glue(void) { return 0; }
CFILE
close $cfh;

my $mapped = $runner->map_location($demo_c, 5);
is($mapped->{mapped}, 1, 'xsubpp #line mapped generated Demo.c:5 back to Demo.xs');
is($mapped->{file}, $demo_xs, 'mapped file points to local Demo.xs');
is($mapped->{line}, 41, 'mapped line computed exact offset (40 + 1 = 41)');

my $unmapped = $runner->map_location($demo_c, 9);
is($unmapped->{mapped}, 0, '#line back to Demo.c stays on Demo.c');

# Remote path remapping check (using synthetic placeholder, never a real host)
$runner->configure_remote(xs_remote_host => 'example-remote', xs_remote_workdir => '/tmp/remote-work');
