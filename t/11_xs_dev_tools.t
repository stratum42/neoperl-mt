# -------------------------------------------------------------------------
# 3. LIVE TSan two-thread data race isolated build (.neoperl-build/tsan)
# -------------------------------------------------------------------------
SKIP: {
    skip 'No C compiler available for live TSan test', 5 unless $tools->{preferred_cc};

    my $tsan_src = <<'C_EOF';
#include <pthread.h>
#include <stdio.h>
static int shared_counter = 0;
static void *racer(void *arg) {
    (void)arg;
    for (int i = 0; i < 1000; i++) shared_counter++;
    return NULL;
}
int main(void) {
    pthread_t t1, t2;
    pthread_create(&t1, NULL, racer, NULL);
    pthread_create(&t2, NULL, racer, NULL);
    pthread_join(t1, NULL);
    pthread_join(t2, NULL);
    printf("%d\n", shared_counter);
    return 0;
}
C_EOF

    my $tres = $xsdev->sanitizer->run_tsan_harness($tsan_src, name => 'tsan_race');
    if (!$tres->{ok} && ($tres->{stderr} // '') =~ /cannot find|unsupported|libtsan/i) {
        skip 'TSan runtime not installed on this host', 5;
    }
    ok($tres->{ok}, 'live TSan harness compiled and ran in .neoperl-build/tsan');
    like($tres->{build_dir}, qr/\.neoperl-build[\/\\]tsan\z/, 'TSan built inside isolated .neoperl-build/tsan');
    ok(!$tres->{clean}, 'TSan detected intentional two-thread data race');
    cmp_ok(scalar(@{ $tres->{findings} }), '>=', 1, 'parsed TSan data race finding');
    cmp_ok(scalar(@{ $tres->{findings}[0]{threads} || [] }), '>=', 2, 'parsed both racing thread stacks');
}

# -------------------------------------------------------------------------
# 4. LIVE 2-Stage Clang/GCC PGO (.neoperl-build/{pgo-base,pgo-gen,pgo-use})
# -------------------------------------------------------------------------
SKIP: {
    skip 'No PGO-capable compiler/llvm-profdata on host', 8
        unless $tools->{preferred_cc} && ($tools->{pgo_family} eq 'gcc' || $tools->{llvm_profdata});

    my $pgo_src = <<'C_EOF';
#include <stdio.h>
#include <stdint.h>
static uint64_t hot_branch(const uint32_t *a, size_t n) {
    uint64_t acc = 0;
    for (size_t i = 0; i < n; i++) {
        uint32_t v = a[i];
        if (v < 95) {
            acc += (uint64_t)v * 3u + 1u;
        } else {
            acc ^= ((uint64_t)v << 5) + 7u;
        }
    }
    return acc;
}
int main(void) {
    static uint32_t data[16384];
    for (size_t i = 0; i < 16384; i++) data[i] = (uint32_t)(i % 100);
    uint64_t total = 0;
    for (int r = 0; r < 60; r++) total += hot_branch(data, 16384);
    printf("%llu\n", (unsigned long long)total);
    return 0;
}
C_EOF

    my $prep = $xsdev->pgo->run_c_pgo($pgo_src, name => 'pgo_live', runs => 2);
    ok($prep->{ok}, "live 2-stage $prep->{family} PGO completed cleanly");
    is(scalar(@{ $prep->{stages} }), 3, 'executed all 3 stages (baseline, pgo_gen, pgo_use)');
    ok($prep->{output_match}, 'PGO optimized binary output matches baseline bit-for-bit');
    cmp_ok($prep->{baseline_ms}, '>', 0, "measured baseline timing ($prep->{baseline_ms} ms)");
    cmp_ok($prep->{pgo_ms},      '>', 0, "measured PGO timing ($prep->{pgo_ms} ms)");
    ok(-e $prep->{profdata_path}, 'merged profile data artifact exists');
    ok(-x $prep->{pgo_binary},    'PGO-optimized binary exists in .neoperl-build/pgo-use');

    my $prom = $xsdev->pgo->promote();
    ok($prom->{ok} && -f $prom->{flag_file}, ':XSPgoPromote wrote pgo_flags.mk cleanly');
}

