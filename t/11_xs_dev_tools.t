# -------------------------------------------------------------------------
# 8. :XSPowerAudit (neoperl_xs_arch_audit) — catches all POWER8+ traps
# -------------------------------------------------------------------------
my $buggy_power_c = <<'C_EOF';
#include <altivec.h>
#include <stdio.h>
#include <stdint.h>
#define MY_PAGE_SIZE 4096
static volatile int worker_ready = 0;
int buggy_fn(const uint8_t *buf, size_t off) {
    char c = getchar();
    if (c < 0) return -1;
    uint32_t v = *(uint32_t *)(buf + off);
    while (__atomic_load_n(&worker_ready, __ATOMIC_RELAXED) == 0) {
        _mm_pause();
    }
    return (int)(v & ~4095);
}
C_EOF

my $audit = $xsdev->power->audit_source($buggy_power_c, 'buggy.c');
ok($audit->{ok} && !$audit->{clean}, 'XSPowerAudit detected traps in buggy.c');
my $by_rule = $audit->{summary}{by_rule};
ok($by_rule->{unsigned_char_trap},      'caught unsigned_char_trap (char = getchar / c < 0)');
ok($by_rule->{hardcoded_4k_page},       'caught hardcoded_4k_page (4096 / ~4095)');
ok($by_rule->{weak_memory_barrier},     'caught weak_memory_barrier (volatile flag / RELAXED)');
ok($by_rule->{missing_smt_yield},       'caught missing_smt_yield (_mm_pause without or 27,27,27)');
ok($by_rule->{altivec_macro_collision}, 'caught altivec_macro_collision (<altivec.h> without #undef)');
ok($by_rule->{unaligned_endian_cast},   'caught unaligned_endian_cast (*(uint32_t *)(buf + off))');

my $clean_power_c = <<'C_EOF';
#if defined(__ALTIVEC__)
#include <altivec.h>
#undef vector
#undef pixel
#undef bool
#endif
#include <unistd.h>
#include <stdint.h>
#include <string.h>
static inline void npl_cpu_relax(void) {
#if defined(__powerpc__)
    __asm__ __volatile__("or 27,27,27" ::: "memory");
#endif
}
int clean_fn(const uint8_t *buf, size_t off, int *ready) {
    long psz = sysconf(_SC_PAGESIZE);
    int ch = fgetc(stdin);
    if (ch < 0) return -1;
    uint32_t v = 0;
    memcpy(&v, buf + off, sizeof(v));
    while (__atomic_load_n(ready, __ATOMIC_ACQUIRE) == 0) {
        npl_cpu_relax();
    }
    return (int)(v + (uint32_t)psz);
}
C_EOF
my $clean_audit = $xsdev->power->audit_source($clean_power_c, 'clean.c');
is($clean_audit->{summary}{total}, 0, 'XSPowerAudit reports 0 findings on clean portable POWER8+ C11');

